# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — لا ترفع .env أبدًا لأي مستودع عام

# من Supabase → Connect → Project URL
SUPABASE_URL=https://cmreofktktfufzhtqodb.supabase.co

# من Supabase → Connect → service_role key (سرّي، للخادم فقط، لا تضعه في أي كود يعمل بالمتصفح)
